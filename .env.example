# Database Configurations
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_second_brain

# Redis Configuration (Untuk Celery)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change_this_to_a_random_secure_secret_key

# Default LLM Provider Settings
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_API_KEY=your-openai-api-key-here
DEFAULT_LLM_MODEL=gpt-4o

# Local LLM Alternative (e.g., Ollama)
# DEFAULT_LLM_PROVIDER=ollama
# DEFAULT_LLM_BASE_URL=http://localhost:11434/v1
# DEFAULT_LLM_API_KEY=ollama
# DEFAULT_LLM_MODEL=llama3
